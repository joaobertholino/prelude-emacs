;;; mail.el --- Gmail via Gnus and the encrypted system keyring -*- lexical-binding: t; -*-
(require 'auth-source)
(require 'cl-lib)

(defconst my/prelude-mail-address "comercial.bertholino@gmail.com")
(defconst my/prelude-mail-directory (expand-file-name "~/.local/share/prelude-mail/"))
(make-directory my/prelude-mail-directory t)
(set-file-modes my/prelude-mail-directory #o700)
(add-to-list 'auth-sources "secrets:Login")

;; Set these before loading Gnus, since its paths are derived at load time.
(setq user-mail-address my/prelude-mail-address
      user-full-name "João Bertholino"
      gnus-home-directory my/prelude-mail-directory
      gnus-directory (expand-file-name "news/" my/prelude-mail-directory)
      gnus-startup-file (expand-file-name "newsrc" my/prelude-mail-directory)
      message-directory (expand-file-name "drafts/" my/prelude-mail-directory)
      mail-user-agent 'message-user-agent
      read-mail-command #'my/prelude-mail-open
      message-send-mail-function #'smtpmail-send-it
      send-mail-function #'smtpmail-send-it
      smtpmail-smtp-server "smtp.gmail.com"
      smtpmail-smtp-service 465
      smtpmail-stream-type 'tls
      smtpmail-smtp-user my/prelude-mail-address
      smtpmail-debug-info nil
      smtpmail-debug-verb nil
      message-kill-buffer-on-exit t
      message-confirm-send t
      message-signature nil
      gnus-select-method '(nnnil "")
      gnus-secondary-select-methods
      `((nnimap "gmail"
                (nnimap-address "imap.gmail.com")
                (nnimap-user ,my/prelude-mail-address)
                (nnimap-server-port 993)
                (nnimap-stream tls)
                (nnimap-authenticator plain)
                (nnimap-expunge never)))
      gnus-options-subscribe "\\`nnimap\\+gmail:INBOX\\'"
      gnus-permanently-visible-groups "\\`nnimap\\+gmail:INBOX\\'"
      gnus-message-archive-group nil
      gnus-agent nil
      gnus-blocked-images t)

(defun my/prelude-mail-configured-p ()
  "Return non-nil if this account has both credentials in the Login keyring."
  (require 'secrets)
  (cl-every
   (lambda (server)
     (secrets-search-items "Login" :application "prelude-mail"
                           :host (car server) :port (cdr server)
                           :user my/prelude-mail-address))
   '(("imap.gmail.com" . "993") ("smtp.gmail.com" . "465"))))

(defun my/prelude-mail-setup ()
  "Read a Google app password privately and save it in the encrypted keyring."
  (interactive)
  (require 'secrets)
  (unless (member "Login" (secrets-list-collections))
    (user-error "The encrypted Login keyring is unavailable"))
  (let (entered password)
    (unwind-protect
        (progn
          (setq entered (read-passwd "Google app password (16 letters; input hidden): ")
                password (replace-regexp-in-string "[[:space:]]" "" entered))
          (unless (string-match-p "\\`[a-zA-Z]\\{16\\}\\'" password)
            (user-error "Enter the 16-letter app password generated by Google"))
          (dolist (server '(("imap.gmail.com" . "993") ("smtp.gmail.com" . "465")))
            (let* ((host (car server)) (port (cdr server))
                   (old (secrets-search-item-paths
                         "Login" :application "prelude-mail" :host host :port port
                         :user my/prelude-mail-address))
                   (created (secrets-create-item
                             "Login" (format "Prelude Gmail (%s)" host) password
                             :application "prelude-mail" :host host :port port
                             :user my/prelude-mail-address)))
              (unless created (user-error "Could not save the credential in the keyring"))
              (dolist (item old) (secrets-delete-item "Login" item))))
          (auth-source-forget-all-cached)
          (message "Gmail credentials saved in the encrypted Login keyring"))
      (when (stringp password) (clear-string password))
      (when (stringp entered) (clear-string entered)))))

(defun my/prelude-mail-open ()
  "Open Gmail in Gnus, configuring authentication first when necessary."
  (interactive)
  (unless (my/prelude-mail-configured-p) (my/prelude-mail-setup))
  (require 'gnus)
  (gnus))

(defun my/prelude-mail-compose ()
  "Compose a Gmail message in Prelude."
  (interactive)
  (require 'gnus-msg)
  (compose-mail))

(defun my/prelude-mail-handle (&optional uri)
  "Open the mail manager, or compose the mailto URI without sending it."
  (if (and uri (not (string-empty-p uri)))
      (progn
        (unless (string-prefix-p "mailto:" uri t) (user-error "Expected a mailto link"))
        (require 'gnus-msg)
        (browse-url-mail uri))
    (my/prelude-mail-open)))

(defun my/prelude-mail-refresh-timer ()
  "Check for new mail every five minutes while Gnus is running."
  (require 'gnus-demon)
  (gnus-demon-add-handler #'gnus-demon-scan-news 5 nil))
(add-hook 'gnus-started-hook #'my/prelude-mail-refresh-timer)
(global-set-key (kbd "C-c m") #'my/prelude-mail-open)
(global-set-key (kbd "C-c M") #'my/prelude-mail-compose)

(provide 'my-prelude-mail)
;;; mail.el ends here
